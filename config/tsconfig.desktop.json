{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "..",
    "outDir": "../out/types",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["electron.vite.config.ts", "../src/**/*.ts", "../src/**/*.tsx"],
  "exclude": ["../dist", "../out", "../release"]
}
