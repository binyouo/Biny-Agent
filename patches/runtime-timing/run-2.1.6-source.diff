diff --git a/packages/run/src/runtime/execution-budget.ts b/packages/run/src/runtime/execution-budget.ts
new file mode 100644
index 0000000..b466f11
--- /dev/null
+++ b/packages/run/src/runtime/execution-budget.ts
@@ -0,0 +1,60 @@
+import { performance } from 'node:perf_hooks';
+import { RunTimeoutError } from '../errors.js';
+
+/** One invocation's cumulative synchronous VM-entry budget, never reset by a bridge. */
+export class ExecutionBudget {
+  private elapsedMs = 0;
+  private startedAt: number | undefined;
+  private depth = 0;
+  private timedOut = false;
+
+  constructor(private readonly limitMs: number) {}
+
+  isExpired(): boolean {
+    const activeMs =
+      this.startedAt === undefined ? 0 : performance.now() - this.startedAt;
+    this.timedOut ||= this.elapsedMs + activeMs > this.limitMs;
+    return this.timedOut;
+  }
+
+  assertActive(): void {
+    if (this.isExpired()) {
+      throw new RunTimeoutError(this.limitMs);
+    }
+  }
+
+  measure<T>(operation: () => T): T {
+    this.assertActive();
+    if (this.depth === 0) {
+      this.startedAt = performance.now();
+    }
+    this.depth += 1;
+    try {
+      const result = operation();
+      this.assertActive();
+      return result;
+    } catch (error) {
+      this.assertActive();
+      throw error;
+    } finally {
+      this.depth -= 1;
+      if (this.depth === 0) {
+        this.elapsedMs += performance.now() - this.startedAt!;
+        this.startedAt = undefined;
+        this.isExpired();
+      }
+    }
+  }
+
+  /** Excludes only an actual synchronous blocking host wait, never a pending Promise. */
+  waitForHost<T>(operation: () => T): T {
+    const startedAt = performance.now();
+    try {
+      return operation();
+    } finally {
+      if (this.startedAt !== undefined) {
+        this.startedAt += performance.now() - startedAt;
+      }
+    }
+  }
+}
