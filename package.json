{
  "name": "@biny012/biny",
  "version": "0.0.1-beta.1",
  "description": "A local-first AI agent for macOS and the terminal.",
  "author": "Biny contributors",
  "homepage": "https://github.com/Thinkya1/Biny",
  "repository": {
    "type": "git",
    "url": "https://github.com/Thinkya1/Biny.git"
  },
  "bugs": {
    "url": "https://github.com/Thinkya1/Biny/issues"
  },
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "biny": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "benchmarks"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "sync:model-metadata": "node scripts/sync-model-metadata.mjs",
    "build": "pnpm build:desktop",
    "build:cli": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-bundled-skills.mjs dist/bundled-skills",
    "build:activity-sidecar": "node scripts/build-activity-sidecar.mjs",
    "test:activity-macos-smoke": "node scripts/activity-macos-smoke.mjs",
    "test:activity": "tsx tests/activity-fts.test.ts && tsx tests/activity-semantic-search.test.ts && tsx tests/activity-suggestions.test.ts && tsx tests/activity-background.test.ts && tsx tests/activity-http.test.ts && tsx tests/activity-tools.test.ts && tsx tests/activity-memory-pipeline.test.ts",
    "test:security": "tsx tests/security.test.ts",
    "test:prompts": "tsx tests/prompts.test.ts",
    "test:skills": "tsx tests/skill-discovery.test.ts && tsx tests/skill-diagnostics.test.ts && tsx tests/skill-tools.test.ts",
    "build:desktop": "pnpm build:cli && pnpm build:activity-sidecar && electron-vite build && node scripts/copy-bundled-skills.mjs out/main/bundled-skills",
    "desktop:dev": "pnpm desktop:prepare && electron-vite dev",
    "desktop:prepare": "pnpm build:activity-sidecar && pnpm exec install-electron --no && pnpm exec electron-rebuild -w node-pty",
    "desktop:preview": "electron-vite preview",
    "desktop:pack": "pnpm build:desktop && electron-builder --mac dir",
    "desktop:dist": "pnpm build:desktop && electron-builder --mac dmg zip --publish never",
    "dev": "node --import tsx src/cli/index.ts",
    "lint": "eslint electron.vite.config.ts scripts src tests",
    "test:models": "node --test scripts/sync-model-metadata.test.mjs",
    "test:runtime-host": "node scripts/run-tests.mjs runtime-host",
    "test:standard": "pnpm test:models && node scripts/run-tests.mjs --standard",
    "test:e2e": "pnpm build:cli && node scripts/run-tests.mjs --e2e",
    "test": "pnpm test:standard && pnpm test:e2e",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json",
    "start": "node dist/cli/index.js",
    "prepack": "pnpm build:cli"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty",
      "onnxruntime-node",
      "sharp"
    ],
    "overrides": {
      "adm-zip": "0.6.0",
      "sharp": "0.35.4",
      "fast-uri": "3.1.6",
      "ip-address": "10.3.1",
      "hono": "4.12.34",
      "@hono/node-server": "2.0.11"
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/google": "4.0.17",
    "@ai-sdk/openai": "4.0.60",
    "@ai-sdk/openai-compatible": "3.0.11",
    "@ai-sdk/provider": "^4.0.10",
    "@astryxdesign/core": "0.2.0",
    "@astryxdesign/theme-neutral": "0.2.0",
    "@earendil-works/pi-tui": "0.82.1",
    "@floating-ui/dom": "1.8.0",
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/agents-core": "0.3.9",
    "@stylexjs/stylex": "0.19.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.93",
    "best-effort-json-parser": "1.2.1",
    "commander": "^13.1.0",
    "framer-motion": "^13.2.0",
    "jieba-wasm": "2.4.0",
    "katex": "^0.18.7",
    "mermaid": "^11.17.2",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "0.35.4",
    "shiki": "^4.4.3",
    "sqlite-vec": "0.1.9",
    "thinking-orbs": "0.2.0",
    "undici": "6.27.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6"
  },
  "packageManager": "pnpm@10.6.5",
  "optionalDependencies": {
    "@mariozechner/clipboard": "0.3.9",
    "sqlite-vec-darwin-arm64": "0.1.9",
    "sqlite-vec-darwin-x64": "0.1.9",
    "sqlite-vec-linux-arm64": "0.1.9",
    "sqlite-vec-linux-x64": "0.1.9",
    "sqlite-vec-windows-x64": "0.1.9"
  }
}
