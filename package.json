{
  "name": "@biny012/biny",
  "version": "0.2.3-beta.0",
  "description": "A local-first, memory-first development agent for macOS and the terminal.",
  "author": "Biny contributors",
  "homepage": "https://github.com/binyouo/Biny-Agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/binyouo/Biny-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/binyouo/Biny-Agent/issues"
  },
  "type": "module",
  "main": "out/main/index.js",
  "bin": {
    "biny": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "benchmarks",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build:icons": "node --import tsx scripts/generate-app-icons.ts",
    "sync:model-metadata": "node scripts/sync-model-metadata.mjs",
    "build": "pnpm build:desktop",
    "build:cli": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/build-code-mode-runtime.mjs && node scripts/build-calendar-sidecar.mjs && node scripts/copy-bundled-skills.mjs dist/bundled-skills && node scripts/copy-browser-extension.mjs dist/browser-extension",
    "build:calendar-sidecar": "node scripts/build-calendar-sidecar.mjs",
    "build:activity-sidecar": "node scripts/build-activity-sidecar.mjs",
    "test:activity-macos-smoke": "node scripts/activity-macos-smoke.mjs",
    "test:activity": "node scripts/run-tests.mjs activity-",
    "test:security": "tsx tests/security.test.ts",
    "test:prompts": "tsx tests/prompts.test.ts",
    "test:skills": "tsx tests/skill-discovery.test.ts && tsx tests/skill-diagnostics.test.ts && tsx tests/skill-tools.test.ts",
    "build:desktop": "node scripts/prepare-rtk.mjs && pnpm build:icons && pnpm build:cli && pnpm build:activity-sidecar && node scripts/prepare-electron-background.mjs && electron-vite build --config config/electron.vite.config.ts && node scripts/copy-bundled-skills.mjs out/main/bundled-skills && node scripts/copy-browser-extension.mjs out/main/browser-extension",
    "desktop:dev": "pnpm desktop:prepare && electron-vite dev --watch --config config/electron.vite.config.ts",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:preview": "electron-vite preview --config config/electron.vite.config.ts",
    "desktop:pack": "pnpm desktop:prepare && pnpm build:desktop && electron-builder --config config/electron-builder.yml --dir",
    "desktop:dist": "pnpm desktop:prepare && pnpm build:desktop && electron-builder --config config/electron-builder.yml --publish never",
    "dev": "node --import tsx src/cli/index.ts",
    "lint": "eslint config/electron.vite.config.ts scripts src tests",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:docs:local": "node scripts/check-docs.mjs --local",
    "check:project": "node --test scripts/project-checks.test.mjs && pnpm check:boundaries && pnpm check:docs",
    "test:models": "node --test scripts/sync-model-metadata.test.mjs",
    "test:runtime-host": "node scripts/run-tests.mjs runtime-host",
    "test:runner": "node --test scripts/run-tests.test.mjs scripts/ci-test-plan.test.mjs",
    "test:standard": "pnpm test:runner && pnpm test:models && pnpm test:code-mode-runtime && node scripts/run-tests.mjs --standard",
    "test:e2e": "pnpm build:cli && node scripts/run-tests.mjs --e2e",
    "test": "pnpm test:standard && pnpm test:e2e",
    "typecheck": "tsc --noEmit && tsc -p config/tsconfig.desktop.json",
    "start": "node dist/cli/index.js",
    "prepack": "pnpm build:cli",
    "test:code-mode-runtime": "node scripts/dependency-patches/runtime-timing-fixtures.mjs",
    "test:code-mode-package": "node scripts/code-mode-packaged-runtime.test.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.8.0",
    "@ai-sdk/anthropic": "4.0.49",
    "@ai-sdk/code-mode": "1.0.50",
    "@ai-sdk/google": "4.0.17",
    "@ai-sdk/openai": "4.0.60",
    "@ai-sdk/openai-compatible": "3.0.11",
    "@ai-sdk/provider": "^4.0.10",
    "@antv/infographic": "0.2.6",
    "@astryxdesign/core": "0.2.0",
    "@astryxdesign/theme-neutral": "0.2.0",
    "@earendil-works/pi-tui": "0.82.1",
    "@floating-ui/dom": "1.8.0",
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@openai/agents-core": "0.3.9",
    "@strudel/web": "1.3.0",
    "@stylexjs/stylex": "0.19.0",
    "@vscode/ripgrep": "1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "7.0.93",
    "beautiful-mermaid": "1.1.3",
    "best-effort-json-parser": "1.2.1",
    "commander": "^13.1.0",
    "croner": "10.0.1",
    "dompurify": "3.4.17",
    "framer-motion": "^13.2.0",
    "jieba-wasm": "2.4.0",
    "jsdom": "^30.1.0",
    "katex": "^0.18.7",
    "mermaid": "^11.17.2",
    "morphdom": "2.7.4",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-cjk-friendly": "2.3.2",
    "remark-cjk-friendly-gfm-strikethrough": "2.3.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "sharp": "0.35.5",
    "shiki": "^4.4.3",
    "smol-toml": "1.9.0",
    "sqlite-vec": "0.1.9",
    "thinking-orbs": "0.2.0",
    "undici": "6.29.1",
    "unified": "11.0.5",
    "ws": "8.21.3",
    "yaml": "^2.8.1",
    "zod": "4.6.7",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.8.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6"
  },
  "packageManager": "pnpm@10.6.5",
  "optionalDependencies": {
    "@mariozechner/clipboard": "0.3.9",
    "sqlite-vec-darwin-arm64": "0.1.9",
    "sqlite-vec-darwin-x64": "0.1.9",
    "sqlite-vec-linux-arm64": "0.1.9",
    "sqlite-vec-linux-x64": "0.1.9",
    "sqlite-vec-windows-x64": "0.1.9"
  }
}
