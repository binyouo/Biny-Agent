{
  "meta": { "title": "Biny 功能架构 04 · 模型与扩展", "lang": "zh-CN" },
  "canvas": { "preset": "4:5", "width": 1200, "height": 1500, "duration": 30, "fps": 30, "preroll": 10 },
  "theme": {
    "preset": "terminal-dark",
    "colors": { "bg": "#161a20", "bar": "#232833", "line": "#4a5367", "line2": "#3a4154", "dim": "#6f788c",
      "fg": "#e4e8f0", "wh": "#ffffff", "cy": "#86e1e6", "cyd": "#3f7d84", "bl": "#8fb4f6", "bld": "#3f5c8a",
      "gr": "#86e0a2", "grd": "#3a6b4c", "pu": "#b9a2f2", "pud": "#5c4b80", "ye": "#e3c07a",
      "or": "#e79a4c", "orl": "#c4783a", "hl": "#2b2f42", "row": "#22323a", "dots": "#566078" }
  },
  "clock": { "start": "14:00:00", "rate": 1 },
  "titlebar": { "text": "~/CodingAgent/biny — model & extensions — 120x46" },
  "credit": { "text": "取自 src/llm/* · src/extensions/* · src/permission/* · src/computer/* 源码 · live-panel" },
  "machines": {
    "reg": { "type": "lane", "period": 7.5, "run": 4.6, "off": 2.9, "busy": "解析模型", "done": ["已就绪"], "phase": 0,
      "log": { "who": "resolver", "c": "bl", "msgs": [["AiRegistry → ModelResolver 选定", "→ session"]] } },
    "stream": { "type": "lane", "period": 7.5, "run": 5.0, "off": 2.5, "busy": "收流中", "done": ["已收完"], "phase": 1.2,
      "log": { "who": "provider", "c": "bl", "msgs": [["按 provider 适配流式协议", "→ 流"]] } },
    "tools": { "type": "lane", "period": 8, "run": 5.2, "off": 2.8, "busy": "执行工具", "done": ["已回填"], "phase": 2.0,
      "log": { "who": "tools", "c": "or", "msgs": [["内置 + MCP 工具统一注册", "→ 结果"]] } },
    "mcp": { "type": "lane", "period": 9, "run": 6.0, "off": 3.0, "busy": "连 MCP", "done": ["已挂载"], "phase": 0.6,
      "log": { "who": "mcp", "c": "cy", "msgs": [["stdio / http 传输接入外部服务", "→ 工具集"]] } },
    "skills": { "type": "lane", "period": 8.5, "run": 5.6, "off": 2.9, "busy": "装载 skills", "done": ["已激活"], "phase": 1.7,
      "log": { "who": "skills", "c": "pu", "msgs": [["按需激活 skill / plugin", "→ 能力"]] } },
    "tokens": { "type": "gauge", "period": 4.6, "t0": 0.4, "seed": 13, "threshold": 70,
      "values": [44, 58, 76, 39, 62, 47, 71, 53],
      "high": { "label": "命中缓存", "dest": "→ 省钱" }, "low": { "label": "未命中", "dest": "→ 全价" },
      "log": { "who": "cache", "c": "gr", "msgs": ["prompt cache 命中样本"], "tail": "hit={value}% {label}" } },
    "sub": { "type": "cycle", "period": 5, "t0": 1.0, "order": [0, 0, 1, 2],
      "values": [
        { "t": "派发", "m": "主 agent 把子任务交出去", "g": "subagent" },
        { "t": "并行", "m": "多个子 agent 同时跑", "g": "并行" },
        { "t": "汇总", "m": "结果回填主上下文", "g": "回收" }
      ] },
    "trig": { "type": "triggers", "color": "ye", "period": 6.8, "on": 4.4, "t0": 1.0, "callsStart": 6,
      "onText": "处理中", "offText": "待命",
      "items": [
        { "name": "要写文件 / 跑命令", "adv": ["» 命中路径策略", "» 请求你确认"], "to": "→ 审批" },
        { "name": "要看桌面窗口", "adv": ["» 走 Computer Use", "» 应用级授权名单"], "to": "→ window" },
        { "name": "任务可切分", "adv": ["» 派给 Subagent", "» 并行再汇总"], "to": "→ sub" }
      ],
      "log": { "who": "policy", "c": "ye", "start": { "m": "{name} · 已拦截", "g": "拦截" }, "end": { "m": "{name} · 已放行", "g": "{to}" } } }
  },
