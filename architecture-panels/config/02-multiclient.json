{
  "meta": { "title": "Biny 功能架构 01 · 多端交互", "lang": "zh-CN" },
  "canvas": { "preset": "4:5", "width": 1200, "height": 1500, "duration": 30, "fps": 30, "preroll": 10 },
  "theme": {
    "preset": "terminal-dark",
    "colors": { "bg": "#161a20", "bar": "#232833", "line": "#4a5367", "line2": "#3a4154", "dim": "#6f788c",
      "fg": "#e4e8f0", "wh": "#ffffff", "cy": "#86e1e6", "cyd": "#3f7d84", "bl": "#8fb4f6", "bld": "#3f5c8a",
      "gr": "#86e0a2", "grd": "#3a6b4c", "pu": "#b9a2f2", "pud": "#5c4b80", "ye": "#e3c07a",
      "or": "#e79a4c", "orl": "#c4783a", "hl": "#2b2f42", "row": "#22323a", "dots": "#566078" }
  },
  "clock": { "start": "09:30:00", "rate": 1 },
  "titlebar": { "text": "~/CodingAgent/biny — 多端交互 — 120x46" },
  "credit": { "text": "取自 src/desktop · src/tui · src/cli · src/widgets 源码 · 动画计数为示意 illustrative · live-panel" },
  "machines": {
    "ipc": { "type": "lane", "period": 7, "run": 4.4, "off": 2.6, "busy": "IPC 转发中", "done": ["已投递"], "phase": 0,
      "log": { "who": "desktop", "c": "cy", "msgs": [["Electron IPC → 主进程 → socket", "→ host"]] } },
    "tui": { "type": "lane", "period": 7, "run": 3.9, "off": 3.1, "busy": "读键位输入", "done": ["已投递"], "phase": 1,
      "log": { "who": "tui", "c": "cy", "msgs": [["TUI reducer 收键位事件", "→ host"]] } },
    "runs": { "type": "lane", "period": 9, "run": 5.6, "off": 3.4, "busy": "跑一次性任务", "done": ["已退出 0"], "phase": 2,
      "log": { "who": "cli", "c": "ye", "msgs": [["biny run → ExecutionService", "→ exec"]] } },
    "widget": { "type": "lane", "period": 8, "run": 5.0, "off": 3.0, "busy": "流式生成 widget", "done": ["可交互"], "phase": 0.5,
      "log": { "who": "widget", "c": "pu", "msgs": [["HTML / SVG 片段流式落盘", "→ 页面"]] } },
    "lease": { "type": "cycle", "period": 4, "t0": 0.6, "order": [0, 0, 1, 2],
      "values": [
        { "t": "占用", "m": "SessionLease 单写者持有", "g": "独占" },
        { "t": "排队", "m": "第二端排队等租约", "g": "串行" },
        { "t": "切换", "m": "上一端释放，下一端接手", "g": "交接" }
      ] },
    "clients": { "type": "gauge", "period": 4.2, "t0": 0.8, "seed": 11, "threshold": 60,
      "values": [38, 52, 71, 44, 63, 35, 58, 47],
      "high": { "label": "同端", "dest": "→ desktop" }, "low": { "label": "多端", "dest": "→ host 排队" },
      "log": { "who": "lease", "c": "gr", "msgs": ["活跃客户端样本"], "tail": "clients={value}% {label}" } },
    "trig": { "type": "triggers", "color": "ye", "period": 6.8, "on": 4.4, "t0": 1.0, "callsStart": 2,
      "onText": "处理中", "offText": "待命",
      "items": [
        { "name": "桌面发起会话", "adv": ["» 主进程建 socket 连接", "» 申请 SessionLease"], "to": "→ host" },
        { "name": "终端发起会话", "adv": ["» TUI 渲染同一 transcript", "» 复用同一 session"], "to": "→ host" },
        { "name": "脚本一次性任务", "adv": ["» 走 ExecutionService", "» 不进交互会话"], "to": "→ exec" }
      ],
      "log": { "who": "client", "c": "ye", "start": { "m": "{name} · 已接入", "g": "接入" }, "end": { "m": "{name} · 已建联", "g": "{to}" } } }
  },
  "elements": [
    { "type": "text", "x": 40, "y": 62, "align": "left", "size": 28, "c": "cy", "b": 1, "t": "01 · 多端交互" },
