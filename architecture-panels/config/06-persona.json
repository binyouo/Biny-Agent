      ] },
    { "type": "box", "x": 420, "y": 806, "w": 360, "h": 190, "color": "gr", "pad": [12, 14, 14],
      "lines": [
        { "align": "left", "runs": [ { "t": "每日自省", "c": "gr", "b": 1 } ] },
        { "align": "left", "t": "从经历生成日记", "c": "fg" },
        { "align": "left", "t": "可重试、互相独立", "c": "fg" },
        { "align": "left", "t": "沉淀记忆 / 人格 / 情绪", "c": "fg" }
      ] },
    { "type": "box", "x": 800, "y": 806, "w": 360, "h": 190, "color": "pu", "pad": [12, 14, 14],
