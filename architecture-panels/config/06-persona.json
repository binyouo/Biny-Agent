    { "type": "log", "x": 40, "y": 1306, "w": 1120, "rows": 4, "padTop": 16, "padBottom": 30, "padLeft": 20,
      "title": "persona log", "titleX": 40, "titleW": 190,
      "cols": [ { "key": "time", "x": 0 }, { "key": "who", "x": 116 }, { "key": "m", "x": 238 }, { "key": "g", "x": 900 } ] },
    { "type": "text", "x": 40, "y": 1460, "align": "left", "size": 16, "c": "dim", "t": "动画计数为示意 (illustrative) · 模块与文件名取自 src/agent/context 源码" }
