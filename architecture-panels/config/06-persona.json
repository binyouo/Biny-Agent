      ] },

    { "type": "text", "x": 40, "y": 786, "align": "left", "size": 18, "c": "dim", "b": 1, "t": "▸ 心跳与自省：让 agent 在没人说话时也在活" },
    { "type": "box", "x": 40, "y": 806, "w": 360, "h": 190, "color": "pk", "pad": [12, 14, 14],
      "lines": [
        { "align": "left", "runs": [ { "t": "心跳 heartbeat", "c": "pk", "b": 1 } ] },
