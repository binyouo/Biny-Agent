      ] },

    { "type": "path", "points": [[600, 514], [600, 554]], "color": "line", "arrow": true },
    { "type": "flow", "path": [[600, 518], [600, 558]], "period": 1.6, "offsets": [0.4, 1.3], "color": "pu" },

    { "type": "box", "x": 40, "y": 560, "w": 540, "h": 196, "color": "ye", "pad": [12, 14, 14],
      "lines": [
        { "align": "left", "runs": [ { "t": "FATIGUE · 疲劳与主动睡眠", "c": "ye", "b": 1 } ] },
