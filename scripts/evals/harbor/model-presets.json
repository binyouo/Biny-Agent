{
  "_comment": "模型预设表。adapter 只在没有 BINY_EVAL_* 环境变量时才查这里。加模型改这个文件，不用动 biny_agent.py。",
  "defaultAlias": "deepseek-v4-flash",
  "presets": {
    "deepseek-v4.1-flash": {
      "provider": "commandcode",
      "type": "openai-compatible",
      "baseUrl": "https://api.commandcode.ai/provider/v1",
      "apiKeyEnv": "COMMANDCODE_API_KEY",
      "model": "deepseek/deepseek-v4.1-flash",
      "apiBackend": "chat_completions",
      "envOverrides": {
        "baseUrl": "BINY_COMMANDCODE_BASE_URL",
        "model": "BINY_COMMANDCODE_MODEL",
        "apiBackend": "BINY_COMMANDCODE_API_BACKEND"
      }
    },
    "deepseek-v4-pro": {
      "provider": "sub2api",
      "type": "openai-compatible",
      "baseUrl": "https://ai.suv.run/v1",
      "apiKeyEnv": "SUB2API_API_KEY",
      "model": "deepseek-v4-pro",
      "apiBackend": "responses",
      "envOverrides": {
        "baseUrl": "BINY_SUB2API_BASE_URL",
        "apiBackend": "BINY_SUB2API_API_BACKEND"
      }
    },
    "deepseek-v4-flash": {
      "provider": "sub2api",
