      "apiBackend": "responses",
      "envOverrides": {
        "baseUrl": "BINY_SUB2API_BASE_URL",
        "apiBackend": "BINY_SUB2API_API_BACKEND"
      }
    },
    "grok": {
      "provider": "xai",
      "type": "openai-compatible",
