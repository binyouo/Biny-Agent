      "apiKeyEnv": "GROK_API_KEY",
      "model": "grok-4.5",
      "apiBackend": "responses",
      "envOverrides": {
        "baseUrl": "BINY_GROK_BASE_URL",
        "model": "BINY_GROK_MODEL",
        "apiBackend": "BINY_GROK_API_BACKEND"
      }
    },
    "grok-4.5": {
      "provider": "xai",
      "type": "openai-compatible",
      "baseUrl": "https://api.x.ai/v1",
