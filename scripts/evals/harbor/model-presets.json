      "baseUrl": "https://opencode.ai/zen/go/v1",
      "apiKeyEnv": "OPENCODE_GO_KEY",
      "model": "deepseek-v4-flash",
      "apiBackend": "chat_completions",
      "envOverrides": {
        "baseUrl": "BINY_OPENCODE_GO_BASE_URL",
        "model": "BINY_OPENCODE_GO_MODEL",
